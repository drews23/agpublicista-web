# AG Publicista — configuración Apache/LiteSpeed (Hostinger)

# Forzar HTTPS y dominio sin www
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# Material fuente de los packs: NUNCA se sirve al público. Las carpetas
# están fuera del repo (gitignore), pero el deploy de Hostinger no borra
# los archivos ya subidos al servidor (solo añade/sobrescribe), así que
# cualquier copia huérfana que quede allí se corta aquí con un 404.
RewriteRule ^svg(/|$) - [R=404,L]
# Ojo: el espacio va como clase [\s] — un espacio literal en el patron
# rompe el parseo de argumentos de Apache y anula la regla.
RewriteRule ^escenas[\s]3d(/|$) - [R=404,L]

# Redirecciones del sitio anterior (WordPress, hasta 2026)
# Google todavía tiene indexadas esas URLs y hoy caen en 404: cada una es
# una visita perdida. Se mandan al equivalente más cercano del sitio actual.
# Las páginas de andamiaje de la plantilla vieja (/layouts/, /team/,
# /testimonials/) se dejan morir en 404 a propósito: eran contenido de
# demostración del tema (perfiles inventados, testimonios falsos), no
# páginas reales del negocio.

# Plantillas de After Effects → la guía actual de plantillas.
# Con (/.*)?$ para atrapar también las páginas de adjunto que generaba
# WordPress bajo cada entrada (…/ice_screenshot_20230124-153641/).
RewriteRule ^(after-effects-mockup-app-promo-iphone-13-pro|animacion-logo-after-effects|plantilla-logo-after-effects-gratis|plantilla-gratis-after-effects-abridor-dinamico|plantilla-gratis-after-effects-grid-slideshow-moderno|plantilla-gratis-after-effects-suscripcion-youtube|plantilla-gratis-after-effects-transiciones-titulos|transicion-after-effects|transicion-after-effects-plantilla|transicion-after-effects-plantilla-gratis|transicion-after-effects-plantilla-gratis-2|transicion-after-effects-plantilla-gratis-3)(/.*)?$ /blog/plantillas-after-effects-gratis/ [R=301,L]

# Privacidad y tratamiento de datos
RewriteRule ^(politicas-de-privacidad|instrucciones-para-eliminacion-de-datos)/?$ /privacidad/ [R=301,L]

# Recursos descargables
RewriteRule ^recursos-visuales/?$ /recursos/ [R=301,L]

# Portafolio y trabajos → los proyectos viven ahora en recursos.
# portfolio_group eran las categorías del portafolio: apuntan a trabajo
# real, así que se redirigen (a diferencia de /team/ o /testimonials/,
# que eran contenido de demostración de la plantilla).
RewriteRule ^(portfolio|portfolio_group|trabajos|branding-buenaldea)(/.*)?$ /recursos/ [R=301,L]

# Artículos de marketing del sitio anterior → el blog actual
RewriteRule ^(calendario-de-contenido-para-redes-sociales|como-desarrollar-mi-plan-de-marketing-digital|conciencia-de-marca-toma-importancia-en-marketing|costos-de-publicidad-en-internet-2023-google-ads|diferencias-entre-publicidad-y-marketing|el-discurso-publicitario|estrategias-marketing-digital-fin-de-ano|estrategias-para-temperatura-del-trafico|formatos-de-video-corto-para-redes-sociales|freelance-story-telling|google-ads-empresas-presupuestos-limitados|google-analytics-marketing-digital|marketing-tradicional-y-marketing-digital|publicidad-en-internet|reputacion-digital-marketing|storytelling|vende-el-problema-que-solventas)/?$ /blog/ [R=301,L]

# Taxonomías del blog anterior. La de recursos visuales va antes porque
# la regla general de /category/ se la llevaría por delante.
RewriteRule ^category/diseno-grafico/recursos-visuales/?$ /recursos/ [R=301,L]
RewriteRule ^(category|tag)(/.*)?$ /blog/ [R=301,L]

# Servicios, proceso y contacto → la página sobre mí
RewriteRule ^(services|services_group|servicios-de-marketing-digital|administracion-de-redes-sociales|contacto|proceso-de-trabajo)(/.*)?$ /sobre-mi/ [R=301,L]

# Página de error personalizada
ErrorDocument 404 /404.html

# Compresión
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json text/xml
</IfModule>

# Caché de navegador
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Cabeceras de seguridad básicas
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
